{
  "name": "simcraft-sync-server",
  "private": true,
  "version": "0.0.1",
  "description": "Self-hosted, Tailscale-only cloud sync server for SimCraft world saves.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsc -b && node dist/index.js",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.3",
    "oxlint": "^1.75.0",
    "supertest": "^7.1.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
