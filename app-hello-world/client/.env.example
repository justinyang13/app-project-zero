# GraphQL API endpoint. Defaults to http://localhost:5043/graphql when unset.
# For the GitHub Pages build this is set via the DEPLOYED_GRAPHQL_URL secret/var
# in .github/workflows/deploy.yml, pointed at the Render-hosted API.
VITE_GRAPHQL_URL=http://localhost:5043/graphql

# NASA API key used to fetch the homepage background from the Astronomy
# Picture of the Day (APOD) API: https://api.nasa.gov. Defaults to the
# shared "DEMO_KEY" when unset, which works instantly but has a low rate
# limit; get a free personal key at https://api.nasa.gov to raise it.
VITE_NASA_API_KEY=DEMO_KEY
